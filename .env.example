# Copie para .env (que não é versionado) e rode com: uv run --env-file .env <comando>
#
# Testes locais: Ollama, pela API compatível com a OpenAI. O Ollama ignora a chave,
# mas o cliente exige um valor não vazio.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama

