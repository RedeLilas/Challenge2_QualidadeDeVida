# Copie para .env (que não é versionado) e rode com: uv run --env-file .env <comando>
#
# Testes locais: Ollama, pela API compatível com a OpenAI. O Ollama ignora a chave,
# mas o cliente exige um valor não vazio.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama

# Opcional: segundos de espera pelo LLM antes de responder que não consegue agora
# (padrão 30, sem nova tentativa). Se mudar, ajuste TEMPO_LIMITE_MS em web/app.js
# para um pouco acima deste valor.
LLM_TIMEOUT=30

# Opcional: raciocínio do modelo (disabled ou enabled). Sem a variável, o parâmetro
# não é enviado; deixe assim no Ollama, que não o conhece.
# LLM_THINKING=disabled

# Produção e comparação da S3 (DeepSeek), sem raciocínio. Só casos fictícios: decisão
# de LGPD, opção (c), em openspec/changes/s2-plataforma-base/design.md.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled
# LLM_API_KEY=<chave do DeepSeek, nunca versionada>
